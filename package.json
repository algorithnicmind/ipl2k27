{
  "name": "ciap",
  "version": "0.1.0",
  "private": true,
  "description": "Cricket Intelligence AI Platform - AI-powered cricket analytics, prediction, and reasoning system",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:ml": "cd ml-service && uvicorn app.main:app --reload --port 8000",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend && npm run test:ml",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:ml": "cd ml-service && pytest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": ["cricket", "ipl", "ai", "machine-learning", "prediction", "analytics"],
  "author": "algorithnicmind",
  "license": "MIT"
}
